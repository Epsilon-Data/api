      "cookie@<0.7.0": ">=0.7.0",
      "@babel/helpers@<7.26.10": ">=7.26.10",
      "cross-spawn@<6.0.6": ">=6.0.6",
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.5",
      "tar-fs@>=2.0.0 <2.1.2": ">=2.1.2",
      "formidable@>=2.1.0 <2.1.3": ">=2.1.3",
      "tar-fs@>=2.0.0 <2.1.3": ">=2.1.3",
      "path-to-regexp@<0.1.12": ">=0.1.12"
    }
  }
