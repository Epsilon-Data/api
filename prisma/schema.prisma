generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Request {
  requestId    String        @id(map: "request_pkey") @default(uuid()) @db.Uuid
  requestorId  String        @db.Uuid
  lastModified DateTime      @default(now()) @db.Date
  createdDate  DateTime      @default(now()) @db.Date
  status       RequestStatus @default(PENDING)
  comments     Comment[]
  connection   Connection?
  analysis     Analysis?
}

model Comment {
  commentId   String   @id(map: "comment_pkey") @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  authorId    String   @db.Uuid
  authorName  String   @db.Text
  content     String   @db.Text
  createdDate DateTime @default(now()) @db.Date
  request     Request  @relation(fields: [requestId], references: [requestId], onDelete: Cascade, onUpdate: NoAction, map: "fk_comment_request_id")
}

model Connection {
  id            String   @id(map: "connection_pkey") @default(uuid()) @db.Uuid
  requestId     String?  @unique @db.Uuid
  projectId     String   @unique @db.Uuid
  orgAdminEmail String?  @db.Text
  request       Request? @relation(fields: [requestId], references: [requestId], onDelete: NoAction, onUpdate: NoAction, map: "fk_connection_request_id")
  project       Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade, onUpdate: NoAction, map: "fk_connection_project_id")
}

model Analysis {
  requestId          String   @id @db.Uuid
  projectId          String   @db.Uuid
  requestorName      String   @db.Text
  requestorEmail     String   @db.Text
  requestorOrgName   String   @db.Text
  requestorPosition  String   @db.Text
  projectName        String   @db.Text
  projectStartDate   DateTime @db.Date
  projectEndDate     DateTime @db.Date
  projectDescription String   @db.Text
  projectObjective   String   @db.Text
  projectOutcome     String   @db.Text
  projectMembers     Json?    @db.Json
  projectEthicsId    String   @db.Text
  request            Request  @relation(fields: [requestId], references: [requestId], onDelete: Cascade, onUpdate: NoAction, map: "fk_analysis_request_id")
  project            Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade, onUpdate: NoAction, map: "fk_analysis_project_id")
}

model Project {
  projectId       String         @id(map: "project_pkey") @default(uuid()) @db.Uuid
  ownerId         String         @db.Uuid
  name            String         @db.Text
  lead            String         @db.Text
  university      String         @db.Text
  faculty         String         @db.Text
  ethicsId        String         @db.Text
  description     String         @db.Text
  startDate       DateTime       @db.Date
  endDate         DateTime       @db.Date
  lastModified    DateTime       @default(now()) @db.Timestamp(6)
  participantsNum Int            @db.Integer
  members         Json?          @db.Json
  dbKeywords      String[]
  createdDate     DateTime       @default(now()) @db.Date
  visualizations  Json?          @db.Json
  status          ProjectStatus  @default(PENDING)
  isPublic        Boolean        @default(false)
  connectionType  ConnectionType @default(CLOUD_CONNECT)
  connection      Connection?
  analysis        Analysis[]
  proxy              Proxy?
  proxyInstallTokens ProxyInstallToken[]

  @@unique([ownerId, projectId])
}

model Notification {
  notificationId        String                  @id(map: "notify_pkey") @default(uuid()) @db.Uuid
  title                 String                  @db.Text
  message               String                  @db.Text
  type                  Int                     @db.SmallInt
  createdDate           DateTime                @default(now()) @db.Date
  NotificationSender    NotificationSender[]
  NotificationRecipient NotificationRecipient[]
}

model NotificationSender {
  notificationId String       @db.Uuid
  senderId       String       @db.Uuid
  status         Int          @db.SmallInt
  senderType     SenderType
  Notification   Notification @relation(fields: [notificationId], references: [notificationId], onDelete: NoAction, onUpdate: NoAction, map: "fk_notify_sender_id")

  @@id([notificationId, senderId])
}

model NotificationRecipient {
  notificationId String             @db.Uuid
  recipientId    String             @db.Uuid
  status         NotificationStatus @default(UNREAD)
  deliveredAt    DateTime?
  Notification   Notification       @relation(fields: [notificationId], references: [notificationId], onDelete: NoAction, onUpdate: NoAction, map: "fk_notify_recipient_id")

  @@id([notificationId, recipientId])
}

enum SenderType {
  USER
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

enum ProjectStatus {
  PENDING
  CRAWLING
  ERROR
  READY
  MAPPED
}

enum ConnectionType {
  CLOUD_CONNECT
  DIRECT_DB
  PROXY
}

enum RequestStatus {
  PENDING
  REVISION
  REJECTED
  APPROVED
}

enum JobStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
}

model BackgroundJob {
  jobId        String    @id(map: "background_job_pkey") @default(uuid()) @db.Uuid
  type         String    @db.Text
  status       JobStatus @default(PENDING)
  result       Json?     @db.Json
  error        String?   @db.Text
  createdDate  DateTime  @default(now()) @db.Timestamp(6)
  lastModified DateTime  @default(now()) @updatedAt @db.Timestamp(6)
}

model Proxy {
  id              String      @id(map: "proxy_pkey") @default(uuid()) @db.Uuid
  projectId       String      @unique @db.Uuid
  project         Project     @relation(fields: [projectId], references: [projectId], onDelete: Cascade, onUpdate: NoAction, map: "fk_proxy_project_id")
  proxyToken      String?     @unique @db.Text
  ratholeToken    String?     @db.Text
  noisePublicKey  String?     @db.Text
  noisePrivateKey String?     @db.Text
  assignedPort    Int?        @unique @db.Integer
  status          ProxyStatus @default(PENDING)
  version         String?     @db.Text
  lastSeenAt      DateTime?   @db.Timestamp(6)
  createdAt       DateTime    @default(now()) @db.Timestamp(6)
  updatedAt       DateTime    @default(now()) @updatedAt @db.Timestamp(6)
}

model ProxyInstallToken {
  id          String    @id(map: "proxy_install_token_pkey") @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  project     Project   @relation(fields: [projectId], references: [projectId], onDelete: Cascade, onUpdate: NoAction, map: "fk_proxy_install_token_project_id")
  name        String    @db.Text
  tokenHash   String    @unique @db.Text
  tokenPrefix String    @db.VarChar(16)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  lastUsedAt  DateTime? @db.Timestamp(6)
}

enum ProxyStatus {
  PENDING
  ONLINE
  OFFLINE
}
