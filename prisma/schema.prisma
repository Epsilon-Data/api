generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConnectionRequest {
  id                      Int           @id(map: "request_pkey") @default(autoincrement()) @db.SmallInt
  requestor               Int?          @db.SmallInt
  projectId               Int?          @db.SmallInt
  status                  Int?          @db.SmallInt
  dbId                    Int?          @db.SmallInt
  orgAdminId              Int?          @db.SmallInt
  dataParticipantsNum     Int?          @db.SmallInt
  dataDescription         String?       @db.VarChar(500)
  dataKeywords            String[]
  additionalInfo          String?       @db.VarChar(500)
  createdDate             DateTime?     @default(now()) @db.Date
  dataCollectionStartDate DateTime?     @db.Date
  dataCollectionEndDate   DateTime?     @db.Date
  ResearcherDb            ResearcherDb? @relation(fields: [dbId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_request_db_id")
  OrgAdmin                OrgAdmin?     @relation(fields: [orgAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_request_org_admin_id")
  Project                 Project?      @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_request_project_id")
}

model OrgAdmin {
  id                Int                 @id(map: "org_admin_pkey") @default(autoincrement()) @db.SmallInt
  email             String?             @db.VarChar(100)
  ConnectionRequest ConnectionRequest[]
}

model Project {
  id                Int                 @id(map: "project_pkey") @default(autoincrement()) @db.SmallInt
  name              String?             @db.VarChar(100)
  lead              String?             @db.VarChar(50)
  university        String?             @db.VarChar(100)
  faculty           String?             @db.VarChar(100)
  ethicsId          String?             @db.VarChar(15)
  description       String?             @db.VarChar(500)
  startDate         DateTime?           @db.Date
  endDate           DateTime?           @db.Date
  members           String[]
  ConnectionRequest ConnectionRequest[]
}

model ResearcherDb {
  id                Int                 @id(map: "researcher_db_pkey") @default(autoincrement()) @db.SmallInt
  name              String?             @db.VarChar(50)
  type              String?             @db.VarChar(15)
  host              String?             @db.VarChar(50)
  port              String?             @db.VarChar(15)
  username          String?             @db.VarChar(100)
  password          String?             @db.VarChar(100)
  status            Int?                @db.SmallInt
  connectDate       DateTime?           @db.Date
  ConnectionRequest ConnectionRequest[]
  Template          Template[]
}

model User {
  id                   Int      @id(map: "user_pkey") @default(autoincrement()) @db.SmallInt
  type                 String   @db.Char(2)
  firstName            String?  @db.VarChar(100)
  lastName             String?  @db.VarChar(100)
  email                String?  @db.VarChar(320)
  gender               String?  @db.Char(2)
  jobTitle             String?  @db.VarChar(255)
  highestQualification String?  @db.VarChar(255)
  institution          String?  @db.VarChar(255)
  faculty              String?  @db.VarChar(255)
  expertiseArea        String?  @db.VarChar(255)
  orgName              String?  @db.VarChar(255)
  orgDepartment        String?  @db.VarChar(255)
  isAdmin              Boolean? @db.Boolean
}

model Template {
  id               Int          @id(map: "template_pkey") @default(autoincrement()) @db.SmallInt
  researcherDbId   Int          @db.SmallInt
  hierarchicalData Json         @db.Json
  researcherDb     ResearcherDb @relation(fields: [researcherDbId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_template_db_id")
}
